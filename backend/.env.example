# --- Telegram ---
BOT_TOKEN=123456:ABC-your-bot-token-from-BotFather
BOT_USERNAME=your_bot_username

# The short name you gave your Mini App in BotFather's /newapp step
# (e.g. if BotFather shows your app link as t.me/your_bot/app, this is "app")
MINI_APP_SHORT_NAME=app

# --- CORS: your Vercel frontend domain(s), comma-separated ---
ALLOWED_ORIGINS=https://your-frontend.vercel.app

# --- Admin ---
ADMIN_IDS=111111111,222222222
ADMIN_API_KEY=replace-with-a-long-random-string

# --- Adsgram ---
ADSGRAM_BLOCK_ID=your-adsgram-block-id
ADSGRAM_CALLBACK_SECRET=replace-with-a-long-random-string

# --- Economy ---
AD_REWARD_USDT=0.003
AD_DAILY_LIMIT=50
AD_COOLDOWN_SECONDS=15
REFERRAL_COMMISSION_PERCENT=10
REFERRAL_SIGNUP_BONUS=0.01
MIN_WITHDRAWAL_USDT=10

# --- Security ---
JWT_SECRET=replace-with-a-long-random-string
INIT_DATA_MAX_AGE_SECONDS=86400

# --- Database (SQLite file, Railway persists via volume) ---
DB_PATH=app_data.db
